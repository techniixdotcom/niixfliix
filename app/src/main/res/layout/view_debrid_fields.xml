<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<com.google.android.material.textfield.TextInputLayout
		style="@style/Widget.Niixfliix.TextField.Dropdown"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:hint="@string/debrid_service">

		<com.google.android.material.textfield.MaterialAutoCompleteTextView
			android:id="@+id/debrid_service"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="none" />
	</com.google.android.material.textfield.TextInputLayout>

	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/debrid_key_layout"
		style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:hint="@string/debrid_key"
		app:endIconMode="password_toggle">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/debrid_key"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:importantForAutofill="no"
			android:inputType="textPassword|textNoSuggestions"
			android:maxLength="200"
			android:maxLines="1" />
	</com.google.android.material.textfield.TextInputLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<Button
			android:id="@+id/debrid_test"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/debrid_test" />

		<TextView
			android:id="@+id/debrid_status"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_weight="1"
			android:textAppearance="?attr/textAppearanceBodySmall" />
	</LinearLayout>

	<Button
		android:id="@+id/debrid_get_key"
		style="@style/Widget.Material3.Button.TextButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/debrid_get_key" />
</merge>
