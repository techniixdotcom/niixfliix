<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/hero"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:focusable="true">

	<ImageView
		android:id="@+id/hero_backdrop"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:importantForAccessibility="no"
		android:scaleType="centerCrop" />

	<View
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/bg_hero_gradient" />

	<LinearLayout
		android:id="@+id/hero_text"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:paddingHorizontal="@dimen/screen_padding"
		android:paddingBottom="12dp">

		<TextView
			android:id="@+id/hero_type"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="6dp"
			android:textAppearance="@style/TextAppearance.Niixfliix.HeroType" />

		<ImageView
			android:id="@+id/hero_logo"
			android:layout_width="wrap_content"
			android:layout_height="88dp"
			android:adjustViewBounds="true"
			android:importantForAccessibility="no"
			android:maxWidth="280dp"
			android:scaleType="fitCenter" />

		<TextView
			android:id="@+id/hero_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:fontFamily="@font/jetbrains_mono_extrabold"
			android:gravity="center"
			android:maxLines="2"
			android:shadowColor="#CC000000"
			android:shadowRadius="8"
			android:textAppearance="?attr/textAppearanceHeadlineMedium"
			android:visibility="gone" />

		<TextView
			android:id="@+id/hero_genres"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:ellipsize="end"
			android:gravity="center"
			android:maxLines="1"
			android:shadowColor="#CC000000"
			android:shadowRadius="6"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="@android:color/white" />

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:gravity="center"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/hero_play"
				style="@style/Widget.Niixfliix.Button.Hero"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minWidth="128dp"
				android:text="@string/details_play"
				app:icon="@drawable/ic_play" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/hero_save"
				style="@style/Widget.Niixfliix.Button.HeroSecondary"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:minWidth="128dp"
				android:text="@string/hero_save"
				app:icon="@drawable/ic_add" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/hero_dots"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:gravity="center"
			android:orientation="horizontal"
			android:visibility="gone" />
	</LinearLayout>
</FrameLayout>
